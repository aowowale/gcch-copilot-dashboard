{
  "name": "gcch-copilot-briefing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:smoke": "playwright test",
    "test:hub": "playwright test --config=playwright.hub.config.ts",
    "test:smoke:headed": "playwright test --headed",
    "validate": "npm run build && npm run test:smoke",
    "validate:all": "npm run build && npm --prefix copilot-briefing run build && npm --prefix copilot-onboarding-hub run build && npm run test:smoke"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.4.6"
  }
}
